{
  "name": "astro-blog-cms",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit",
    "deploy": "astro build && wrangler deploy",
    "db:migrate:local": "wrangler d1 execute astro-blog --local --file=./migrations/0001_init.sql",
    "db:seed:local": "wrangler d1 execute astro-blog --local --file=./migrations/0002_local_owner.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.2",
    "@astrojs/react": "^6.0.6",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/static-renderer": "^3.31.3",
    "astro": "^7.3.3",
    "jose": "^6.2.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@cloudflare/workers-types": "^5.20260920.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.135.0"
  }
}
