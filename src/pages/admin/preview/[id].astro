---
import Base from '../../../layouts/Base.astro';
import { canEdit } from '../../../lib/auth';
import { renderDocument } from '../../../lib/content';
import { getPost } from '../../../lib/posts';

const user = Astro.locals.user!;
const post = await getPost(Astro.params.id ?? '');
if (!post || !canEdit(user, post.author_id)) return Astro.redirect('/admin');
const html = renderDocument(JSON.parse(post.draft_json));
---
<Base title={`Preview: ${post.title || 'Untitled'} · Northstar Journal`}>
  <div class="preview-banner"><span>Draft preview — only editors can see this</span><a href={`/admin/posts/${post.id}`}>Back to editor</a></div>
  <article class="article">
    <header class="article-header"><p class="eyebrow">Preview</p><h1>{post.title || 'Untitled draft'}</h1>{post.excerpt && <p>{post.excerpt}</p>}</header>
    {post.cover_media_id && <img class="article-cover" src={`/media/${post.cover_media_id}`} alt="" />}
    <div class="prose" set:html={html} />
  </article>
</Base>
