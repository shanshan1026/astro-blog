{
  "name": "astro-blog-cms",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "astro-blog",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "astro-blog-media"
    }
  ]
}
