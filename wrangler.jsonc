{
	"name": "astro-blog-cms",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist/client"
	},
	"compatibility_date": "2026-09-20",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"routes": [
		{
			"pattern": "331026.cc.cd/*",
			"zone_name": "331026.cc.cd"
		},
		{
			"pattern": "shanhua.cc.cd",
			"custom_domain": true
		}
	],
	"workers_dev": true,
	"vars": {
		"ADMIN_HOST": "shanhua.cc.cd"
	},
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "8ea3981a5ace4e97a72694e1a725ee27"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "astro-blog",
			"database_id": "d03eed0c-2416-48bc-9e85-fe7684842f0e",
			"migrations_dir": "./migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "astro-blog-media"
		}
	]
}
